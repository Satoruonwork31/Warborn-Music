# ─────────────────────────────────────────────────────────────────────────
#  Warborn Music — environment template
#
#  1. Copy this file to `.env`   ->   cp .env.example .env
#  2. Fill in the REQUIRED values below.
#  3. Everything under "Optional" can stay blank; sensible defaults apply.
#
#  `.env` is gitignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────


# ═══ REQUIRED ════════════════════════════════════════════════════════════

# Telegram API credentials — https://my.telegram.org -> API development tools
API_ID=
API_HASH=

# Bot token from @BotFather
BOT_TOKEN=

# Assistant userbot session string. Generate with:
#   python3 scripts/session_gen.py
# WARNING: a leaked STRING_SESSION grants FULL access to that Telegram
# account (not just bot scope). Treat it like a password.
STRING_SESSION=

# Deployer's Telegram user id(s). Comma/space-separated list accepted.
OWNER_ID=


# ═══ BRANDING & PUBLIC LINKS (optional) ══════════════════════════════════
# Shown on /start, /help and /stats. Leave a link blank and its button is
# simply hidden. Links accept a full URL, a @username, or a t.me/handle.

BOT_NAME=Warborn Music
# Public @username of THIS bot (for the "Add me to your group" button).
# Leave blank to auto-detect at runtime.
BOT_USERNAME=

SUPPORT_CHAT=
UPDATE_CHANNEL=
OWNER_URL=

# Numeric id of a channel/group to receive event logs (start/add/download).
# Add the bot there as admin. Can also be set at runtime with /setlog.
LOG_GROUP_ID=

# Additional delegated sudo users (comma/space list). No owner powers.
SUDO_USERS=

# Banner images for /start and /help (any direct image URL).
START_IMAGE=
HELP_IMAGE=
# Welcome-card art (used by the join/greeting image).
WELCOME_BANNER_URL=
WELCOME_AVATAR_URL=


# ═══ PERSISTENCE (optional but recommended) ══════════════════════════════
# Without Redis all state (served chats, /stats reach, greetings, sudo,
# blacklist, gban, log channel) lives in local JSON and RESETS on every
# redeploy. Set REDIS_URL to persist across restarts (free tier at
# console.upstash.com -> Redis -> Connect -> the rediss:// URL).
REDIS_URL=
# Optional key namespace (default "warborn").
REDIS_PREFIX=warborn


# ═══ SPOTIFY (optional) ══════════════════════════════════════════════════
# Needed only to resolve Spotify links. https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=


# ═══ COOKIES (optional, recommended on cloud/VPS) ════════════════════════
# Datacenter IPs are blocked by YouTube/Instagram for anonymous access.
# Export a Netscape-format cookies.txt from a logged-in browser session.
#   *_FILE     — path to a cookies.txt on disk (VPS/Docker volume).
#   *_CONTENT  — the RAW cookies.txt contents pasted inline (PaaS hosts that
#                only allow env vars). If both are set, *_FILE wins.
COOKIES_FILE=
COOKIES_CONTENT=
INSTAGRAM_COOKIES_FILE=
INSTAGRAM_COOKIES_CONTENT=
# Folder of extra *.txt cookie jars for automatic health-based rotation.
COOKIES_DIR=
# Optional: rotate a still-healthy jar once older than this many hours.
# COOKIE_FORCE_REFRESH_HOURS=24
# How often (minutes) the background health checker probes the active jar.
# COOKIE_CHECK_INTERVAL_MIN=30


# ═══ PROXY (optional) ════════════════════════════════════════════════════
# A residential proxy is the most reliable fix for YouTube bot-checks on a
# datacenter/VPS IP. PROXY_URL covers Telegram + yt-dlp; YT_DLP_PROXY is a
# yt-dlp-only override.
PROXY_URL=
YT_DLP_PROXY=
# Comma-separated YouTube Proof-of-Origin tokens (advanced; see yt-dlp wiki).
YT_PO_TOKEN=


# ═══ EXTERNAL MEDIA API (optional) ═══════════════════════════════════════
# Audio FETCH gateway for YouTube. Song selection is done by YouTube search;
# the chosen URL is fetched via this API so the bot never hits YouTube's
# throttled CDN directly. Provider-agnostic — see bot/utils/mediaapi.py.
API_URL=
API_KEY=

# Optional media-downloader microservice for Instagram/Pinterest. When set,
# IG/Pinterest downloads call it first and fall back to local yt-dlp.
MEDIA_API_URL=
MEDIA_API_KEY=
# Kill switch for the media API's Instagram path (default true).
MEDIA_API_INSTAGRAM_ENABLED=true
# Backup endpoints (comma-separated): url|key,url|key,...
# MEDIA_API_BACKUP_URLS=
# Encryption secret for the endpoint registry file — set a strong random string.
# API_REGISTRY_SECRET=


# ═══ ADVANCED / TUNABLES (optional) ══════════════════════════════════════
# Allow a JioSaavn last-resort fallback when the YouTube fetch fails (may
# play a different rendition/language). Default 0 (off).
# ALLOW_JIOSAAVN_FALLBACK=0

# Rolling-deploy guard (Railway/PaaS): seconds to wait for an old instance
# to shut down before connecting the userbot. Set 0 to disable.
# USERBOT_START_DELAY=25

# Optional heading line on the /waifu card, e.g. "🌸 My Music Bot".
# WAIFU_BRAND=

# Groups larger than this are not polled for welcome/farewell (real-time
# paths still cover them). Keep modest — polling costs API calls.
# WELCOME_POLL_MAX_MEMBERS=1000
